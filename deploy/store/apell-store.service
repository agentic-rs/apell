[Unit]
Description=Apell applet store
After=network.target

[Service]
Type=simple
User=apell-store
Group=apell-store
WorkingDirectory=/opt/apell-store/current
ExecStart=/opt/apell-store/current/apell-store
Environment=APELL_STORE_LISTEN=127.0.0.1:8788
Environment=APELL_STORE_DATA_DIR=/var/lib/apell-store
Environment=APELL_STORE_WEB_DIR=/opt/apell-store/current/web
Environment=APELL_STORE_PUBLISH_TOKEN_FILE=/etc/apell-store/publish-token
EnvironmentFile=-/etc/apell-store/environment
StateDirectory=apell-store
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
