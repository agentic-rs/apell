# Inside the public HTTPS server block for ACCOUNT_ENDPOINT.
# Forward the core port only. The admin console remains on its loopback port.
# Enable Account Center in Logto before switching this route into service.
location = / {
  access_log off;
  return 302 /account/security;
}

location / {
  access_log off;
  error_log /dev/null;
  proxy_cache off;
  proxy_set_header Host $server_name;
  proxy_set_header X-Forwarded-Host $server_name;
  proxy_set_header Forwarded "";
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_pass http://127.0.0.1:5656;
}
