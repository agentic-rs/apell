{
  "name": "apell-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:chatbot && vite",
    "dev:local": "node --experimental-strip-types scripts/local-dev.ts",
    "build": "pnpm build:chatbot && tsc --noEmit && vite build",
    "build:chatbot": "node --experimental-strip-types scripts/build-chatbot.ts",
    "sync:app-icons": "node --experimental-strip-types scripts/sync-app-icons.ts",
    "tauri": "node --experimental-strip-types scripts/tauri.ts",
    "desktop:dev": "pnpm dev:local shell",
    "desktop:build": "pnpm tauri build",
    "landing:dev": "vite --config scripts/landing-vite.config.ts",
    "store:build": "tsc --project store/web/tsconfig.json && vite build --config store/web/vite.config.ts",
    "store:dev": "vite --config store/web/vite.config.ts",
    "store:serve": "cargo run --locked -p apell-store",
    "ios:init": "pnpm tauri ios init && pnpm ios:prepare",
    "ios:prepare": "node --experimental-strip-types scripts/prepare-ios.ts",
    "ios:dev": "pnpm tauri ios dev",
    "android:init": "pnpm tauri android init",
    "android:dev": "pnpm tauri android dev",
    "test": "pnpm build:chatbot && vitest run",
    "check": "pnpm build && cargo test -p apell-core",
    "check:shell-profile": "node --experimental-strip-types scripts/check-shell-profile.ts",
    "format": "prettier --write . && cargo fmt --all && cargo fmt --manifest-path examples/chatbot/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --all --check && cargo fmt --manifest-path examples/chatbot/Cargo.toml --check",
    "check:staged": "node --experimental-strip-types scripts/check-staged.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
